{
  "name": "@game-editor/runtime",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@game-editor/assets": "workspace:*",
    "@game-editor/core": "workspace:*",
    "@game-editor/game-components": "workspace:*",
    "@game-editor/project": "workspace:*",
    "@game-editor/scene": "workspace:*",
    "@game-editor/shared": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
