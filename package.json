{
  "name": "html5-game-editor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @game-editor/editor --filter @game-editor/project-server dev",
    "dev:demo": "pnpm --filter @game-editor/editor dev:demo",
    "build": "pnpm -r --filter \"./packages/**\" run build && pnpm -r --filter \"./apps/**\" --filter \"./games/**\" run build",
    "build:demo": "pnpm --filter @game-editor/editor build:demo",
    "build:pages": "pnpm build:demo && node scripts/assemble-github-pages.mjs",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "lint:deps": "depcruise apps packages games --config .dependency-cruiser.mjs --output-type err",
    "install-libresprite": "pnpm --filter @game-editor/project-server install-libresprite"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.32.0",
    "globals": "^16.3.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0",
    "dependency-cruiser": "^17.3.2",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "sharp"]
  }
}
