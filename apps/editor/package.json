{
  "name": "@game-editor/editor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:demo": "tsc -p tsconfig.json --noEmit && vite build --mode demo",
    "preview": "vite preview",
    "preview:demo": "vite preview --mode demo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@game-editor/assets": "workspace:*",
    "@game-editor/commands": "workspace:*",
    "@game-editor/core": "workspace:*",
    "@game-editor/editor-core": "workspace:*",
    "@game-editor/game-components": "workspace:*",
    "@game-editor/project": "workspace:*",
    "@game-editor/renderer-pixi": "workspace:*",
    "@game-editor/renderer-three": "workspace:*",
    "@game-editor/runtime": "workspace:*",
    "@game-editor/scene": "workspace:*",
    "@game-editor/shared": "workspace:*",
    "dockview": "^4.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  }
}
