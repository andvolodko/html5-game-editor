{
  "name": "@game-editor/project-server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@game-editor/assets": "workspace:*",
    "@game-editor/core": "workspace:*",
    "@game-editor/game-components": "workspace:*",
    "@game-editor/project": "workspace:*",
    "@game-editor/scene": "workspace:*",
    "@game-editor/shared": "workspace:*",
    "busboy": "^1.6.0",
    "image-size": "^2.0.2"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/node": "^22.17.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
